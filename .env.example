# Rent2Cool – Beispiel-Umgebung
#
# Kopiere diese Datei nach `.env` und passe die Werte an. NIEMALS echte
# Zugangsdaten, Schlüssel oder Kundendaten committen (siehe CLAUDE.md).
# Die Werte hier sind bewusst nur für die lokale Docker-Compose-Umgebung
# gedacht (D-005). Alle Konfiguration kommt ausschließlich aus Umgebungs-
# variablen (12-Factor).
#
# Platzhalter nach D-015 sind mit PLACEHOLDER_ bzw. TODO(D-015) markiert,
# damit sie vor dem Go-live gefunden werden.

# --- Allgemein ---
NODE_ENV=development
# Öffentliche Basis-Domain – Platzhalter bis Domain gesichert ist (D-013/D-015)
PUBLIC_BASE_DOMAIN=rent2cool.example

# --- apps/core (Backend) ---
CORE_HTTP_HOST=0.0.0.0
CORE_HTTP_PORT=3000
# Log-Level: trace|debug|info|warn|error|fatal
LOG_LEVEL=debug

# --- apps/admin (interne Admin-Oberfläche, Next.js) ---
# Läuft auf Port 3002. Login über Keycloak (Client rent2cool-admin, PKCE).
NEXTAUTH_URL=http://localhost:3002
# Signiert/verschlüsselt das Sitzungs-Cookie – in echt aus dem Secret-Store (D-015).
NEXTAUTH_SECRET=PLACEHOLDER_NEXTAUTH_SECRET_bitte_lokal_ersetzen
ADMIN_OIDC_CLIENT_ID=rent2cool-admin
ADMIN_OIDC_CLIENT_SECRET=PLACEHOLDER_ADMIN_OIDC_CLIENT_SECRET
# Basis-URL der Kern-API, die die Oberfläche serverseitig aufruft.
CORE_API_URL=http://localhost:3000
# Lokale Testnutzer im Keycloak-Realm (D-015): admin.dev, ops.dev, qa.dev,
# kunde.dev – Passwort jeweils PLACEHOLDER_dev_passwort (nur lokal!).

# --- apps/ingest (Telematik-Eingang, T-003) ---
INGEST_HTTP_HOST=0.0.0.0
INGEST_HTTP_PORT=3001

# --- PostgreSQL + TimescaleDB ---
# Nur Standard-PostgreSQL-Schnittstelle (D-005). In der Cloud: verwalteter
# PostgreSQL/Timescale-Dienst, nur diese URL ändert sich.
DATABASE_URL=postgres://rent2cool:rent2cool_local_dev@localhost:5432/rent2cool
POSTGRES_USER=rent2cool
POSTGRES_PASSWORD=rent2cool_local_dev
POSTGRES_DB=rent2cool

# --- Warteschlange: Kafka-API (lokal Redpanda) ---
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=rent2cool-core
# Topic für rohe Telematik-Nachrichten (T-003)
KAFKA_TOPIC_TELEMETRY_RAW=telemetry.raw
KAFKA_CONSUMER_GROUP=rent2cool-core-telemetry

# Telematik-Verarbeiter im Kern (T-003). true = Kafka-Consumer starten.
TELEMETRY_CONSUMER_ENABLED=false
# HMAC-Schlüssel für die Telematik-Signatur – Platzhalter bis Anbieterwahl (D-015).
# Eingang und Simulator müssen denselben Schlüssel verwenden.
TELEMETRY_SIGNING_KEY=PLACEHOLDER_TELEMETRY_SIGNING_KEY
# HMAC-Schlüssel für die Signatur des Temperaturnachweises – Platzhalter bis PKI (D-015).
BERICHT_SIGNING_KEY=PLACEHOLDER_BERICHT_SIGNING_KEY

# --- Rechnung (R-63) ---
# Umsatzsteuer-Standardsatz in Prozent und Währung (vom Steuerberater bestätigen).
RECHNUNG_STEUERSATZ=19
RECHNUNG_WAEHRUNG=EUR

# --- Hintergrundjobs: BullMQ auf Valkey (Redis-kompatibel) ---
VALKEY_URL=redis://localhost:6379
# Berichtsdienst: Temperaturnachweis automatisch nach Mietende (+ Karenzzeit)
BERICHT_WORKER_ENABLED=true
BERICHT_KARENZ_MIN=30
BERICHT_SUCHE_SEK=300
# Elektronisches Siegel der Nachweis-PDFs: leer = Testsiegel (ohne Rechtswirkung, D-015)
SIEGEL_P12_BASE64=
SIEGEL_P12_PASSWORT=
# E-Mail (lokal Mailpit: Ansicht http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_ABSENDER=Rent2Cool Nachweise <nachweise@rent2cool.example>

# --- Objektspeicher: S3-API (lokal SeaweedFS, D-019) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-central-1
S3_ACCESS_KEY=rent2cool_local
S3_SECRET_KEY=rent2cool_local_secret
S3_BUCKET=rent2cool-local
S3_FORCE_PATH_STYLE=true

# --- Anmeldung und Rollen: Keycloak (OpenID Connect) ---
OIDC_ISSUER_URL=http://localhost:8080/realms/rent2cool
OIDC_CLIENT_ID=rent2cool-core
# Lokaler Entwicklungs-Client-Secret-Platzhalter – in echt aus dem Secret-Store
OIDC_CLIENT_SECRET=PLACEHOLDER_OIDC_CLIENT_SECRET
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_dev

# --- Beobachtbarkeit: OpenTelemetry ---
# Leer lassen = Tracing aus (z. B. in Tests/CI). Gesetzt = Export an Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rent2cool-core

# --- Platzhalter-Stammdaten (D-015) ---
# Firmenstandort bis Sitz feststeht (D-011/D-015)
PLACEHOLDER_HQ_NAME=Rent2Cool HQ (Platzhalter)
PLACEHOLDER_HQ_STREET=Musterstraße 1
PLACEHOLDER_HQ_ZIP=00000
PLACEHOLDER_HQ_CITY=Musterstadt
PLACEHOLDER_HQ_COUNTRY=DE
# Datenschutzbeauftragter bis externer DSB beauftragt (D-015)
PLACEHOLDER_DPO_NAME=PLACEHOLDER_DPO
PLACEHOLDER_DPO_EMAIL=dpo@rent2cool.example
