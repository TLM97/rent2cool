{
  "name": "@rent2cool/core",
  "version": "0.0.0",
  "private": true,
  "description": "Kern (Backend + Datenbank): modularer Monolith (D-001/D-002)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/seed.ts",
    "db:seed:demo": "tsx src/db/seed/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.1",
    "@opentelemetry/sdk-node": "^0.57.1",
    "@rent2cool/shared": "workspace:*",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "bullmq": "6.3.16",
    "drizzle-orm": "^0.38.3",
    "ioredis": "6.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.4.0",
    "node-forge": "1.4.0",
    "nodemailer": "6.10.1",
    "pdfkit": "0.20.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "6.4.24",
    "@types/pdfkit": "0.17.6",
    "drizzle-kit": "^0.30.6",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
