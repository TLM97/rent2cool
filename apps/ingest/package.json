{
  "name": "@rent2cool/ingest",
  "version": "0.0.0",
  "private": true,
  "description": "Telematik-Eingang: nimmt Nachrichten an, prüft Format + Signatur und schreibt nur in die Warteschlange (D-001/D-012, T-003).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rent2cool/shared": "workspace:*",
    "fastify": "^5.2.1",
    "kafkajs": "^2.2.4",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
